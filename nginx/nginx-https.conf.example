# =============================================================================
# nginx-https.conf.example — Carico 3D (produzione, HTTPS)
#
# ATTIVAZIONE (in ordine, sul server Linux):
#   1. Ottenere il certificato:  sh ops/certbot.sh tuodominio.com
#      (crea /etc/letsencrypt e /var/www/certbot; serve la porta 80 aperta)
#   2. Copiare questo file su nginx/nginx.conf:
#        cp nginx/nginx-https.conf.example nginx/nginx.conf
#   3. Sostituire ogni occorrenza di "example.com" con il dominio reale.
#   4. Scommentare i mount TLS nel servizio nginx di docker-compose.yml.
#   5. Attivare i flag in .env (vedi in fondo) e riavviare:
#        docker compose up -d
#
# HSTS viene emesso da Django (SECURE_HSTS_SECONDS) e non qui, per non
# duplicare la policy in due punti. Gli altri header restano in nginx.
# =============================================================================
upstream django {
    server web:8000;
}

# Rate limit per-IP sul solo endpoint di login/landing (richieste a `/`).
limit_req_zone $binary_remote_addr zone=login_zone:10m rate=5r/s;

# ---------------------------------------------------------------------------
# HTTP: serve solo il challenge ACME e reindirizza tutto il resto su HTTPS.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name example.com www.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS: applicazione vera e propria.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name example.com www.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;

    # Upload PNG icone (max 500 KB lato app, margine incluso)
    client_max_body_size 2m;

    # CSP in osservazione: non blocca, evidenzia gli script inline da sistemare
    # prima di promuoverla a policy effettiva senza unsafe-inline.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Upload icone — volume /data (priorità su /static/ per path più specifico)
    location /static/caricamento/img/ {
        alias /data/img_uploads/;
        access_log off;
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Static raccolti — volume /static (collectstatic)
    location /static/ {
        alias /static/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Landing + login (POST /): rate limit anti brute-force come seconda barriera
    # oltre a django-axes. burst=10 assorbe i refresh rapidi della landing.
    location = / {
        limit_req zone=login_zone burst=10 nodelay;
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}

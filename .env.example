# =============================================================================
# .env.example — copiare in .env e valorizzare (il .env NON va in git)
#   cp .env.example .env
# Uso locale:  python manage.py runserver
# Uso Docker:  docker compose up -d --build   (DB_HOST=postgres)
# =============================================================================

# --- Database PostgreSQL (OBBLIGATORIO) ---
DB_NAME=carico_3d
DB_USER=carico
DB_PASSWORD=cambiami
DB_HOST=localhost            # con Docker Compose: postgres
DB_PORT=5432

# --- Django (OBBLIGATORIO) ---
SECRET_KEY=cambiami-con-una-chiave-forte-aleatoria
DEBUG=False                  # in sviluppo: True
ALLOWED_HOSTS=localhost,127.0.0.1,tuodominio.com

# --- HTTPS / CSRF (produzione) ---
CSRF_TRUSTED_ORIGINS=https://tuodominio.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://tuodominio.com
SECURE_SSL_REDIRECT=False    # True in produzione (o redirect in nginx)
SESSION_COOKIE_SECURE=False  # True in produzione (HTTPS)
CSRF_COOKIE_SECURE=False     # True in produzione (HTTPS)
SECURE_HSTS_SECONDS=0         # 31536000 solo dopo aver verificato HTTPS stabile
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Proxy fidati da cui accettare X-Real-IP (IP/CIDR separati da virgola).
# Vuoto = fidati solo i peer privati/loopback (nginx sul bridge Docker).
TRUSTED_PROXY_IPS=
LOG_LEVEL=INFO

# --- Lemon Squeezy — Pagamenti (Merchant of Record) ---
# Creare account su lemonsqueezy.com, attivare test mode, creare i prodotti
# "Carico3D Mensile" ($19/mese, standard pricing) e "Carico3D Annuale" ($190/anno).
# Copiare API Key, Store ID, Webhook Secret e i variant ID dei due prodotti.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MENSILE_ID=
LEMONSQUEEZY_VARIANT_ANNUALE_ID=

# --- Icone (solo Docker: percorsi dei volumi, impostati nel compose) ---
# ICON_CONFIG_PATH=/data/icon_config.json
# ICON_UPLOAD_DIR=/data/img_uploads
